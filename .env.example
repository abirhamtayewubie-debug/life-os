# Copy to .env.local. Leave the Supabase values empty to run in demo mode
# (labelled sample data, nothing saved).

# Public by design: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used for email-confirmation links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode only: which time zone "today" uses.
DEMO_TIMEZONE=Africa/Addis_Ababa

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) -------------------
# Phase 7: notifications on devices. Generate once: npx web-push generate-vapid-keys
# The public half is meant for browsers; the private half is secret.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Phase 7: reminder sender (/api/cron/reminders). The secret key bypasses RLS and is
# used only there. CRON_SECRET must be at least 32 characters.
# SUPABASE_SECRET_KEY=
# CRON_SECRET=
# Tests only, never in hosting: allow a local stand-in push service.
# PUSH_TEST_ENDPOINTS=
# Phase 6: AI assistant (usage-billed, Anthropic). Without it the assistant shows setup steps.
# Set a spend limit in the Anthropic console as well.
# ANTHROPIC_API_KEY=
# Tests only: point at the scripted stand-in in tests/e2e/mock-anthropic.ts.
# ANTHROPIC_BASE_URL=
